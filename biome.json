{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/.next",
			"!**/.lighthouseci",
			"!**/lighthouse-reports",
			"!**/.lighthouse-browser.json",
			"!public/traffic-rules/app-store-badge-uk.svg",
			"!public/traffic-rules/google-play-badge-uk.svg"
		]
	},
	"formatter": {
		"enabled": true,
		"includes": [
			"**/*.cjs",
			"**/*.css",
			"**/*.js",
			"**/*.json",
			"**/*.jsonc",
			"**/*.mjs",
			"**/*.ts",
			"**/*.tsx"
		],
		"indentWidth": 2,
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"includes": [
			"**/*.cjs",
			"**/*.css",
			"**/*.js",
			"**/*.json",
			"**/*.jsonc",
			"**/*.mjs",
			"**/*.ts",
			"**/*.tsx"
		],
		"rules": {
			"preset": "recommended",
			"a11y": {
				"useValidLang": "warn"
			}
		}
	}
}
