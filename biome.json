{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/.next",
			"!**/.lighthouseci",
			"!**/lighthouse-reports",
			"!**/.lighthouse-browser.json",
			"!public/traffic-rules/app-store-badge-uk.svg",
			"!public/traffic-rules/google-play-badge-uk.svg"
		]
	},
	"formatter": {
		"enabled": true,
		"indentWidth": 2,
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": {
				"useValidLang": "warn"
			}
		}
	}
}
