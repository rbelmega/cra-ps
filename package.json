{
	"name": "cra-ps",
	"version": "0.1.0",
	"private": true,
	"dependencies": {
		"next": "16.3.6",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-markdown": "10.1.0",
		"rehype-highlight": "7.0.2",
		"remark-gfm": "4.0.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/node": "26.6.3",
		"sass": "1.105.0",
		"source-map-explorer": "2.5.3",
		"typescript": "7.0.2"
	},
	"overrides": {
		"postcss": "8.5.28"
	},
	"scripts": {
		"analyze": "npm run build && source-map-explorer .next/static/**/*.js",
		"dev": "next dev",
		"build": "next build --webpack",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"start": "next start",
		"test": "npm run build && node --test test/*.test.mjs"
	},
	"browserslist": [
		"chrome >= 120",
		"edge >= 120",
		"firefox >= 115",
		"and_chr >= 120",
		"and_ff >= 115",
		"safari >= 17",
		"ios_saf >= 17",
		"not dead",
		"not op_mini all"
	]
}
